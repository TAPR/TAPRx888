# KiCad temporary, backup, and per-user state files

# Backups
*.bak
*-bak
*.kicad_pcb-bak
*.kicad_sch-bak
*-backups/

# Autosave / temp
_autosave-*
\#auto_saved_files#
*.tmp
*~

# Per-user project-local state (regenerated by KiCad)
*.kicad_prl
.net

# Caches
fp-info-cache
.history/

# Generated fabrication / documentation outputs (produced by kicad-cli / CI,
# published as artifacts — not committed)
/production/
/gerbers/
/fab/
*.rpt
erc.rpt
drc.rpt

# JLCPCB Fabrication Toolkit output
/jlcpcb/

# Generated board STEP export (kicad-cli / KiBot output — regenerated, not
# committed). Scoped to the root board so it does NOT swallow the vendored
# component 3D models tracked under 3d/ (see 3d/README.md) — a bare *.step would.
/TAPRX-888.step
/TAPRX-888.stp

# Build output dir: the release package AND the mechanical fit-check exports
# (out/step/*.step, out/glb/*.glb, the assembly STEP/GLB/viewer) all land here —
# regenerated by CI, never committed. mechanical/enclosure.step is a committed
# source artifact (the EE<->ME interface), not a build product, so it stays
# tracked (it is not under out/ and not the root board STEP).
/out/

# Python bytecode
__pycache__/
*.pyc

# KiCad lock files
*.lck

# Exported netlist (build product)
/TAPRX-888.net
